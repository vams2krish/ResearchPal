# Copy this file to .env and fill in what you use.

# Which text-generation backend to try first: "gemini" or "ollama".
# The other one is used automatically as a fallback if the primary fails
# (missing key, network error, rate limit, model not pulled, etc).
PRIMARY_LLM=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Must already be pulled locally (`ollama pull <model>`).
OLLAMA_MODEL=gemma4
OLLAMA_HOST=http://localhost:11434

# Ollama silently truncates the prompt to a small default context window
# (often 2048-4096 tokens) regardless of what the model can really handle,
# unless told otherwise. 8192 covers a full paper section batch; raise it
# only if you have RAM to spare (each extra 1K tokens costs real memory).
OLLAMA_NUM_CTX=8192

# Embeddings always run locally through Ollama (free, private, no API key)
# so the vector store never depends on which LLM backend you pick above.
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
